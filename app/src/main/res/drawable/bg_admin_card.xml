<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">

        <shape android:shape="rectangle">

            <solid android:color="#FFF0E7" />

            <corners android:radius="18dp" />

            <stroke
                android:width="1dp"
                android:color="#F26B21" />

        </shape>

    </item>

    <item>

        <shape android:shape="rectangle">

            <solid android:color="#FFFFFF" />

            <corners android:radius="18dp" />

            <stroke
                android:width="1dp"
                android:color="#F0E5DC" />

            <padding
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="1dp" />

        </shape>

    </item>

</selector>