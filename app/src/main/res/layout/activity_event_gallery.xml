<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF9F4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/btnGalleryBack"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="‹ Back"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/tvGalleryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Event Gallery"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvGalleryCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:text="0 photos"
        android:textColor="#666666"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvGalleryEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="24dp"
        android:text="Loading gallery..."
        android:textColor="#666666"
        android:textSize="16sp" />

    <GridView
        android:id="@+id/gridGallery"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnWidth="150dp"
        android:numColumns="2"
        android:horizontalSpacing="8dp"
        android:verticalSpacing="8dp"
        android:padding="8dp"
        android:clipToPadding="false"
        android:stretchMode="columnWidth"
        android:visibility="gone" />
</LinearLayout>
